    <script type="application/javascript">
    globalThis.__canvas_resized = (self, ecw, ech) => {}

    // Animação suave da barra de progresso durante o download e descompactação
    let simProgress = 10;
    const progressEl = document.getElementById('progress');
    const percentEl = document.getElementById('progress-percent');
    const statusEl = document.getElementById('status');

    const progressTracker = setInterval(() => {
        if (!progressEl) return;

        // Atualiza a barra proporcionalmente ao progresso real ou simulado
        if (progressEl.value < 90) {
            simProgress += Math.max(0.6, (90 - simProgress) * 0.04);
            if (!progressEl.value || progressEl.value < simProgress) {
                progressEl.value = Math.floor(simProgress);
            }
        }
        if (percentEl) {
            percentEl.innerText = `${Math.floor(progressEl.value)}%`;
        }
    }, 150);

    async function custom_onload(debug_hidden) {
        console.log(__FILE__, "custom_onload");
        // Mantém a barra de progresso visível!
        const transfer = document.getElementById("transfer");
        if (transfer) {
            transfer.style.display = "flex";
            transfer.hidden = false;
        }
    }

    function custom_prerun() {
        console.log(__FILE__, "custom_prerun");
        if (statusEl) statusEl.innerText = "Inicializando Python Runtime...";
    }

    function custom_postrun() {
        console.log(__FILE__, "custom_postrun");
        if (statusEl) statusEl.innerText = "Preparando recursos táticos...";
        if (progressEl) progressEl.value = 95;
        if (percentEl) percentEl.innerText = "95%";
    }

    // Desbloqueia contexto de áudio do navegador e ativa o loop do jogo
    function unlockMediaAndStart() {
        if (window.MM) {
            window.MM.UME = true;
        }
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) {
                const ctx = new AudioCtx();
                ctx.resume();
            }
        } catch (e) {}

        if (progressEl) progressEl.value = 100;
        if (percentEl) percentEl.innerText = "100%";
        clearInterval(progressTracker);

        const transfer = document.getElementById("transfer");
        if (transfer) transfer.style.display = "none";
        const infoboxBtn = document.getElementById("infobox");
        if (infoboxBtn) infoboxBtn.style.display = "none";

        const canvas = document.getElementById("canvas");
        if (canvas) {
            canvas.style.visibility = "visible";
            canvas.focus();
        }
    }

    const infoboxBtn = document.getElementById("infobox");
    if (infoboxBtn) {
        infoboxBtn.addEventListener("click", unlockMediaAndStart);
        infoboxBtn.addEventListener("touchend", unlockMediaAndStart);
    }
    const transferBox = document.getElementById("transfer");
    if (transferBox) {
        transferBox.addEventListener("click", () => {
            if (infoboxBtn && infoboxBtn.style.display === "block") {
                unlockMediaAndStart();
            }
        });
    }
    window.addEventListener("click", () => {
        if (window.MM) window.MM.UME = true;
    });
    window.addEventListener("keydown", () => {
        if (window.MM) window.MM.UME = true;
    });
    </script>

