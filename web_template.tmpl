import sys
import asyncio
import platform
import json
from pathlib import Path

async def custom_site():
    import embed
    platform.document.body.style.background = "#0b0f19"

    bundle = "{{cookiecutter.archive}}"
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    # unpack filesystem from compressed archive into work dir
    if platform.window.location.host.find('.itch.zone') > 0:
        import zipfile
        async with platform.fopen("{{cookiecutter.archive}}.apk", "rb") as archive:
            with zipfile.ZipFile(archive) as zip_ref:
                zip_ref.extractall(appdir.as_posix())
    else:
        import tarfile
        async with platform.fopen("{{cookiecutter.archive}}.tar.gz", "rb") as archive:
            tar = tarfile.open(fileobj=archive, mode="r:gz")
            tar.extractall(path=appdir.as_posix(), filter='tar')
            tar.close()

    # Detecta se main.py está na raiz (padrão) ou em assets/
    if (appdir / "main.py").exists():
        loaderhome = appdir
        main = appdir / "main.py"
    elif (appdir / "assets" / "main.py").exists():
        loaderhome = appdir / "assets"
        main = appdir / "assets" / "main.py"
    else:
        loaderhome = appdir
        main = appdir / "main.py"

    import os
    if str(loaderhome) not in sys.path:
        sys.path.insert(0, str(loaderhome))
    os.chdir(str(loaderhome))

    platform.run_main(PyConfig, loaderhome=loaderhome, loadermain=None)

    while embed.counter() < 0:
        await asyncio.sleep(.1)

    # Garante que main.py receba os metadados corretos
    __import__(__name__).__file__ = main

    # Desbloqueio de mídia (áudio) se necessário
    if not getattr(platform.window.MM, "UME", True):
        msg = "⚔️ CLIQUE PARA INICIAR ⚔️"
        platform.window.infobox.innerText = msg
        platform.window.show_infobox()
        espera = 0
        while not getattr(platform.window.MM, "UME", False) and espera < 50:
            await asyncio.sleep(.1)
            espera += 1

    platform.window.MM.UME = True

    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)
    __import__(__name__).__file__ = main

    def ui_callback(pkg):
        platform.window.status.innerText = f"Instalando {pkg}..."

    # Garante instalação e vinculação completa do pacote pygame-ce no WebAssembly
    try:
        import aio.pep0723
        await aio.pep0723.pip_install("pygame")
    except Exception as ex:
        print(f"Preload pygame: {ex}")

    await shell.source(main, callback=ui_callback)

    # Game started: hide overlay and display canvas cleanly
    platform.window.transfer.style.display = "none"
    platform.window.infobox.style.display = "none"
    platform.window.canvas.style.visibility = "visible"
    platform.window.canvas.focus()
    platform.window.config.gui_divider = 1
    platform.window.window_resize()

    shell.interactive()

asyncio.run(custom_site())

